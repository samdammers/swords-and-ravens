@page
@model agot_bg_website.Areas.Admin.Pages.Games.IndexModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Admin - Games";

    // Builds a sortable column header link that preserves the current search/page-size and
    // resets back to page 1 (sorting differently makes the previous page number meaningless).
    IHtmlContent SortHeader(string column, string label)
    {
        var url = Url.Page(
            "./Index",
            new
            {
                Search = Model.Search,
                PageNumber = 1,
                PageSize = Model.PageSize,
                SortBy = column,
                SortDir = Model.NextSortDir(column),
            }
        );
        var indicator = Model.SortIndicator(column);
        var text = string.IsNullOrEmpty(indicator) ? label : $"{label} {indicator}";
        return new HtmlString($"<a class=\"link link-hover text-base-content\" href=\"{url}\">{text}</a>");
    }
}

<partial name="_AdminNav" />

<h1 class="text-2xl font-bold mb-4">Games</h1>

<partial name="_StatusMessage" for="StatusMessage" />

<form method="get" class="mb-4 flex gap-2">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <input type="hidden" name="SortBy" value="@Model.SortBy" />
    <input type="hidden" name="SortDir" value="@Model.SortDir" />
    <input type="text" name="Search" value="@Model.Search" class="input" placeholder="Search by name or id" />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<div class="overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th>@SortHeader("name", "Name")</th>
                <th>@SortHeader("owner", "Owner")</th>
                <th>@SortHeader("state", "State")</th>
                <th>@SortHeader("lastActive", "Last active")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var game in Model.Games)
            {
                <tr>
                    <td>@game.Name</td>
                    <td>@if (game.OwnerUser is not null) { <a class="link" href="/user/@game.OwnerUserId" target="_blank" rel="noopener noreferrer">@game.OwnerUser.DisplayName</a> }</td>
                    <td>@game.State</td>
                    <td>@game.LastActiveAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <a class="btn btn-sm" asp-page="./Edit" asp-route-id="@game.Id">View / Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
